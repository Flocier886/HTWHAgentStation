# Copy to .env and replace all credentials before starting Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PASSWORD=replace-with-a-local-mysql-password
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=replace-with-your-openai-compatible-api-key
APP_PORT=8091
